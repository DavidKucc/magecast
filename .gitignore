# --- Mixamo content: allowed inside the game, not as downloadable files ---
# The character and its animations stay on the author's disk. The web build carries them baked in,
# which the Mixamo terms allow; a public repo of the raw FBX would not.
/Assets/Characters/
/Assets/Characters.meta
/Assets/Animation/**/*.fbx
/Assets/Animation/**/*.fbx.meta
/Assets/Animation/*.fbx
/Assets/Animation/*.fbx.meta

